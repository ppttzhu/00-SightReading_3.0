# Cloudflare KV Storage Configuration
#
# 1. Create KV namespace: `npx wrangler kv namespace create STAGES_KV`
# 2. Add the namespace ID to wrangler.toml
# 3. Set CMS_SECRET: `npx wrangler pages secret put CMS_SECRET`
# 4. Set VITE_CMS_SECRET below (client-side, for teacher CMS)

# Optional: Secret token for teacher CMS write access
# Must match CMS_SECRET set in Cloudflare Pages secrets
VITE_CMS_SECRET=

# Supabase Auth
# Get these from Supabase Dashboard -> Project Settings -> API Keys
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key for future Cloudflare Functions.
# Do not prefix this with VITE_ and do not expose it in browser code.
# Set it as a Cloudflare Pages secret only when backend code needs elevated access.
# SUPABASE_SECRET_KEY=

# Leaderboards (能力榜 / 努力榜 / 关卡通关榜) are stored in Supabase.
# After auth.sql, run docs/supabase/leaderboards.sql in the SQL Editor.
