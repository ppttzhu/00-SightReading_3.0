# GitHub Gist Storage Configuration
# 
# 1. Create a PUBLIC gist at https://gist.github.com with a file named "stages.json" (content: {})
# 2. Copy the Gist ID from the URL: https://gist.github.com/YOUR_USERNAME/THIS_IS_THE_GIST_ID
# 3. Generate a Personal Access Token at https://github.com/settings/tokens with "gist" scope
# 4. Copy this file to .env and fill in the values

# Required: The Gist ID (from the gist URL)
VITE_GIST_ID=

# Required for teacher (CMS) to publish: Your GitHub PAT with "gist" scope
VITE_GIST_TOKEN=

# Optional but recommended: Your GitHub username (enables faster raw URL reads)
VITE_GIST_OWNER=
